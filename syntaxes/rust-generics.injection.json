{
  "scopeName": "rust.generics.injection",
  "injectionSelector": "L:source.rust -comment -string",
  "patterns": [
    {
      "include": "#type-ref"
    },
    {
      "include": "#type-params-decl"
    }
  ],
  "repository": {
    "type-ref": {
      "comment": "Rust's grammar matches `Name<` as one unit, so there is no position where a begin/end injection could open. Match the whole Name<...> instead and re-scope the argument list. Bounded to one line; '<' must hug the identifier, which comparisons do not.",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(<)([^<>;{}]*(?:<[^<>;{}]*(?:<[^<>;{}]*(?:<[^<>;{}]*>[^<>;{}]*)*>[^<>;{}]*)*>[^<>;{}]*)*)(>)",
      "captures": {
        "1": {
          "name": "entity.name.type.rust"
        },
        "2": {
          "name": "punctuation.brackets.angle.rust"
        },
        "3": {
          "patterns": [
            {
              "match": "\\b(dyn|impl|mut|const|as|where)\\b",
              "name": "keyword.other.rust"
            },
            {
              "match": "'[a-z_][A-Za-z0-9_]*",
              "name": "entity.name.type.lifetime.rust"
            },
            {
              "match": "\\b(bool|char|str|u8|u16|u32|u64|u128|usize|i8|i16|i32|i64|i128|isize|f32|f64)\\b",
              "name": "entity.name.type.primitive.rust"
            },
            {
              "match": "[<>]",
              "name": "punctuation.brackets.angle.rust"
            },
            {
              "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b",
              "name": "entity.name.type.generic.rust"
            }
          ]
        },
        "4": {
          "name": "punctuation.brackets.angle.rust"
        }
      }
    },
    "type-params-decl": {
      "comment": "Declaration sites (trait Foo<T>, struct Foo<T>) - the host grammar scopes the name itself, leaving '<' free, so a begin/end works here. Bounded to one line.",
      "begin": "(?<=[A-Za-z0-9_])(<)(?![\\s=<-])",
      "beginCaptures": {
        "1": {
          "name": "punctuation.brackets.angle.rust"
        }
      },
      "end": "(>)|(?=[;{]|$)",
      "endCaptures": {
        "1": {
          "name": "punctuation.brackets.angle.rust"
        }
      },
      "patterns": [
        {
          "match": "\\b(dyn|impl|mut|const|as|where)\\b",
          "name": "keyword.other.rust"
        },
        {
          "match": "'[a-z_][A-Za-z0-9_]*",
          "name": "entity.name.type.lifetime.rust"
        },
        {
          "match": "\\b(bool|char|str|u8|u16|u32|u64|u128|usize|i8|i16|i32|i64|i128|isize|f32|f64)\\b",
          "name": "entity.name.type.primitive.rust"
        },
        {
          "match": "[<>]",
          "name": "punctuation.brackets.angle.rust"
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b",
          "name": "entity.name.type.generic.rust"
        }
      ]
    }
  }
}
